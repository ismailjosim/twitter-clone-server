{
	"compilerOptions": {
		"module": "ESNext",
		"moduleResolution": "bundler",
		"target": "ES2023",
		"esModuleInterop": true,
		"strict": true,
		"rootDir": "./src",
		"outDir": "./dist",
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"types": ["node"]
	},
	"include": ["src"],
	"exclude": ["node_modules"]
}
